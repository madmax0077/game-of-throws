# --- Database ---
# For local dev with a Postgres server, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/gameofthrows?schema=public"
# On Vercel, Vercel Postgres provides this for you automatically when you link the DB.
DATABASE_URL="postgresql://user:password@host:5432/gameofthrows?schema=public"

# --- Auth ---
# Generate a strong secret. On Linux/macOS:  openssl rand -base64 32
# On Windows PowerShell:  [Convert]::ToBase64String((1..32 | %{ Get-Random -Max 256 }))
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# In production, set this to your full Vercel URL, e.g. https://gameofthrows.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional: set this to the same origin you serve from, so /watch share links work.
# (Leave unset to default to NEXTAUTH_URL in production.)
# NEXT_PUBLIC_APP_URL="https://gameofthrows.vercel.app"

# --- Admin ---
# The application supports exactly ONE admin account. These env vars decide
# its email + password. The admin user is auto-created (and rotated) on the
# next render of /admin, and any *other* user with role=ADMIN is demoted to
# ORGANIZER so the system can never have multiple admins.
#
# Defaults (used when these env vars are missing):
#   ADMIN_EMAIL    = admin@cricamdcos.buzz
#   ADMIN_PASSWORD = Royal!Throws#2026
#
# CHANGE THESE in production — set them in Vercel project settings and the
# password will rotate on the next /admin render.
# ADMIN_EMAIL="admin@cricamdcos.buzz"
# ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- Email notifications ---
# When an organizer submits a new tournament, the admin (ADMIN_EMAIL above)
# gets a notification email containing a one-click "Approve" button. The
# button hits /admin/approve?token=... with a 14-day HMAC-signed token, so
# the admin doesn't need to log in to approve.
#
# We use Resend's HTTP API (https://resend.com). Sign up, verify a sending
# domain (or use the onboarding@resend.dev sender during testing), grab
# an API key, and set:
#
#   RESEND_API_KEY  - your Resend API key (required to actually send email)
#   EMAIL_FROM      - the From: address, e.g.
#                       "Game of Throws <no-reply@cricamdcos.buzz>"
#                     (default: Game of Throws <onboarding@resend.dev>)
#
# If RESEND_API_KEY is missing, tournament creation still works — we just
# log the email we would have sent and skip the network call.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Game of Throws <no-reply@cricamdcos.buzz>"
