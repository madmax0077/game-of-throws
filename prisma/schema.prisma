// Game of Throws — Prisma schema
// Cricket data model: User -> Tournament -> Team(s) -> Player(s) -> Match -> Innings -> Ball

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  // Roles: ORGANIZER (manages tournaments, teams, scoring), PLAYER (own profile + browse),
  // ADMIN (super), or legacy USER (treated as ORGANIZER for back-compat).
  role         String   @default("ORGANIZER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournaments         Tournament[] @relation("OrganizerTournaments")
  approvedTournaments Tournament[] @relation("ApprovedTournaments")
  players             Player[]
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  city        String
  format      String   @default("CUSTOM") // CUSTOM | T20 | ODI | TEST | T10 | SIXES (auto-derived from overs)
  overs       Int      @default(6) // overs per innings (1-9 supported in UI)
  ballType    String   @default("LEATHER") // LEATHER | TENNIS | OTHER
  startDate   DateTime
  endDate     DateTime
  bannerUrl   String?
  status      String   @default("UPCOMING") // UPCOMING | LIVE | COMPLETED
  // Moderation: new tournaments are created with "PENDING" by the API and
  // are only visible to the organizer who created them (and to admins)
  // until an ADMIN marks them APPROVED. REJECTED tournaments stay hidden
  // from the public but remain visible to their organizer + admins.
  // Default kept as APPROVED so existing rows on schema migration remain
  // visible — the create endpoint always sets PENDING for non-admins.
  approvalStatus  String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer  User  @relation("OrganizerTournaments", fields: [organizerId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedTournaments", fields: [approvedById], references: [id], onDelete: SetNull)
  teams      Team[]
  matches    Match[]

  @@index([organizerId])
  @@index([status])
  @@index([approvalStatus])
  @@index([approvedById])
}

model Team {
  id           String   @id @default(cuid())
  name         String
  shortName    String // e.g. MUM, CHE
  logoUrl      String?
  homeCity     String?
  tournamentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament   Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  players      Player[]
  joinRequests JoinRequest[]

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  @@index([tournamentId])
}

model Player {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("BATTER") // BATTER | BOWLER | ALL_ROUNDER | WICKETKEEPER
  battingHand String   @default("RIGHT") // RIGHT | LEFT
  bowlingArm  String? // RIGHT | LEFT
  bowlingType String? // FAST | MEDIUM | SPIN | LEG_SPIN | OFF_SPIN
  jerseyNo    Int?
  // True for the team captain. The API enforces "at most one captain
  // per team" by clearing the previous captain when a new one is set.
  isCaptain   Boolean  @default(false)
  avatarUrl   String?
  teamId      String?
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ball-by-ball references
  ballsAsStriker    Ball[] @relation("Striker")
  ballsAsNonStriker Ball[] @relation("NonStriker")
  ballsAsBowler     Ball[] @relation("Bowler")
  ballsAsOutBatter  Ball[] @relation("OutBatter")
  ballsAsFielder    Ball[] @relation("Fielder")

  joinRequests JoinRequest[]

  @@index([teamId])
}

model Match {
  id           String   @id @default(cuid())
  tournamentId String
  homeTeamId   String
  awayTeamId   String
  venue        String
  scheduledAt  DateTime
  overs        Int      @default(20) // default T20
  tossWinnerId String? // teamId
  tossDecision String? // BAT | BOWL
  status       String   @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | ABANDONED
  resultText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam   Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  innings    Innings[]

  @@index([tournamentId])
  @@index([status])
}

model Innings {
  id            String   @id @default(cuid())
  matchId       String
  number        Int // 1 or 2 (or higher for super-overs)
  battingTeamId String
  bowlingTeamId String
  totalRuns     Int      @default(0)
  totalWickets  Int      @default(0)
  totalBalls    Int      @default(0)
  isClosed            Boolean  @default(false)
  isSuperOver         Boolean  @default(false) // tie-break leg only (innings #3+): 1 over, 2× team runs
  superOverOneActive  Boolean  @default(false) // regular innings: 2× team runs for the current over only
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  balls Ball[]

  @@unique([matchId, number])
  @@index([matchId])
}

model Ball {
  id           String   @id @default(cuid())
  inningsId    String
  overNumber   Int // 0-indexed
  ballInOver   Int // 1-6 (legal balls)
  legal        Boolean  @default(true)
  runs         Int      @default(0) // runs off the bat
  extraType    String? // WIDE | NO_BALL | BYE | LEG_BYE | PENALTY
  extraRuns    Int      @default(0)
  isWicket     Boolean  @default(false)
  wicketType   String? // BOWLED | CAUGHT | LBW | RUN_OUT | STUMPED | HIT_WICKET
  strikerId    String
  nonStrikerId String
  bowlerId     String
  outBatterId  String?
  // The fielder credited with the dismissal — required for CAUGHT/RUN_OUT/STUMPED
  // wicket types, null otherwise. Used to award fielding points in player stats.
  fielderId    String?
  commentary          String?
  teamRunsMultiplier  Int      @default(1) // 1 or 2 — stored per ball for undo / history
  createdAt           DateTime @default(now())

  innings    Innings @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  striker    Player  @relation("Striker", fields: [strikerId], references: [id])
  nonStriker Player  @relation("NonStriker", fields: [nonStrikerId], references: [id])
  bowler     Player  @relation("Bowler", fields: [bowlerId], references: [id])
  outBatter  Player? @relation("OutBatter", fields: [outBatterId], references: [id])
  fielder    Player? @relation("Fielder", fields: [fielderId], references: [id])

  @@index([inningsId])
  @@index([bowlerId])
  @@index([strikerId])
  @@index([fielderId])
}

// A player can REQUEST to join a team in a scheduled tournament. The team's
// tournament organizer can approve / reject. When approved, the API sets
// Player.teamId = the requested team.
model JoinRequest {
  id        String   @id @default(cuid())
  teamId    String
  playerId  String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
  @@index([status])
}
